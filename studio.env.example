# Configuración de Studio IA Local. Copia este archivo como "studio.env" y edítalo.
# Las líneas que empiezan por # se ignoran. En ⚙️ Modelos → «📋 config» copias un perfil entero.

# --- Modelos (deben existir en Ollama; el panel "Modelos" los descarga) ---
# Perfil equilibrado (16 GB de RAM o GPU de 8 GB). El programador usa el mismo modelo que el chat:
# así la GPU no tiene que cambiar de modelo cada vez que el supervisor delega (mucho más rápido).
MODEL_CHAT=qwen3:8b
MODEL_CODE=qwen3:8b
MODEL_VISION=qwen3-vl:8b-instruct
MODEL_EMBED=qwen3-embedding:0.6b
# Ligero (8 GB de RAM, sin GPU): un solo modelo que ve imágenes y usa herramientas
#   MODEL_CHAT=qwen3-vl:4b-instruct  MODEL_CODE=qwen3-vl:4b-instruct  MODEL_VISION=qwen3-vl:4b-instruct
# Potente (GPU de 24 GB): MoE muy rápido
#   MODEL_CHAT=qwen3:30b-a3b-instruct-2507-q4_K_M  MODEL_CODE=qwen3:30b-a3b-instruct-2507-q4_K_M  NUM_CTX=16384

# --- Motores de inferencia (v1.3) ---
# auto = el estudio elige para cada modelo el motor más rápido que lo lea (Ollama, llama.cpp, ONNX Runtime GenAI,
# OpenVINO GenAI, LiteRT-LM, ExecuTorch, MLC LLM, TensorRT-LLM o Qualcomm Genie). Cada modelo se puede fijar
# a mano en ⚙️ Modelos → «Dónde se ejecuta cada modelo»; esto es solo el valor por defecto.
ENGINE=auto
# Dónde se carga: auto | gpu (VRAM) | cpu (RAM) | mixed (parte y parte) | npu
PLACEMENT=auto
# Con PLACEMENT=mixed: cuántas capas van a la GPU (el resto a la RAM). Solo Ollama y llama.cpp
# GPU_LAYERS=20
# Carpeta para modelos que no son de Ollama (carpetas ONNX/OpenVINO/MLC/TensorRT/Genie, .gguf, .pte, .litertlm)
# MODELS_DIR=data/models
# llama-server para .gguf sueltos (ruta al ejecutable) o uno ya en marcha
# LLAMA_SERVER=C:\llama.cpp\llama-server.exe
# LLAMA_SERVER_URL=http://127.0.0.1:8080
# Servidores externos ya arrancados: MLC LLM ("mlc_llm serve") y TensorRT-LLM ("trtllm-serve", Linux/WSL + NVIDIA)
# MLC_URL=http://127.0.0.1:8000
# TRTLLM_URL=http://127.0.0.1:8001
# Qualcomm Genie en PC Snapdragon X: carpeta del SDK QAIRT que contiene genie-t2t-run
# GENIE_BIN=C:\Qualcomm\AIStack\QAIRT\2.40\bin\aarch64-windows-msvc
# Máximo de tokens por respuesta en los motores que no son Ollama
MAX_NEW_TOKENS=2048

# --- Rendimiento del motor ---
# Contexto en tokens. 8192 cabe en GPUs de 8 GB con qwen3:8b; súbelo si tienes VRAM de sobra.
NUM_CTX=8192
# Cuánto tiempo siguen los modelos en memoria tras usarse (evita recargas de varios segundos)
KEEP_ALIVE=30m
# Razonamiento "thinking" de Qwen3: true = respuestas algo mejores en problemas difíciles pero mucho más lentas
THINK=false
# Precargar el modelo de chat al arrancar el estudio
WARMUP=true

# --- Red local: pon LAN=true para usar el estudio desde la app Android ---
LAN=false
# ACCESS_TOKEN=   (si lo dejas vacío con LAN=true se genera uno y se guarda en data/token.txt)
PORT=8765

# --- Voz ---
# Modelo de transcripción faster-whisper: tiny, base, small, medium, large-v3-turbo (este último con GPU NVIDIA)
WHISPER_MODEL=small
# Idioma del dictado (es, en, eu, ca...). Fijarlo ahorra la detección y evita confusiones. Vacío = automático
WHISPER_LANGUAGE=es
# 1 = el más rápido; 5 = algo más preciso y 2-3 veces más lento
WHISPER_BEAM=1
# Voz de Piper: deja un archivo .onnx (y su .onnx.json) en la carpeta "voices"

# --- Generación de imágenes (opcional): URL de ComfyUI ---
# COMFYUI_URL=http://127.0.0.1:8188

# --- Agentes ---
ENABLE_CODE_EXEC=true
CODE_EXEC_TIMEOUT=30
MAX_AGENT_STEPS=8
